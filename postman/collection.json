      "item": [
        {
          "name": "Admin Signup (Skip if exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData && jsonData.id) {",
                  "        pm.environment.set('testUserId', jsonData.id);",
                  "        console.log('User ID set:', jsonData.id);",
                  "    }",
                  "} else if (pm.response.code === 409) {",
                  "    console.log('Admin user already exists - continuing...');",
                  "} else {",
                  "    console.error('Unexpected response:', pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Admin\",\n    \"lastName\": \"User\",\n    \"email\": \"admin@hua.gr\",\n    \"password\": \"{{adminPassword}}\",\n    \"role\": [\"admin\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
